# Copy to config.env and edit. It must not hold GitHub credentials; keep it
# untracked because it contains your GitHub target and local test settings.
# Little-CI scripts source config.env if it is present.

# Registration scope and exact GitHub target. Organization runners require an
# organization-scoped token and a restricted runner group.
GITHUB_SCOPE="repository" # repository or organization
GITHUB_URL="https://github.com/OWNER/REPO"
# RUNNER_GROUP="little-ci-private-repositories" # organization scope only

# REQUIRED: replace this example with a stable identity for this one fleet.
# Use lowercase letters/numbers/dots/underscores/hyphens; do not reuse it.
FLEET_ID="mac-studio"

# How many runners to provision on this box.
# One runner is the safe default for ordinary Macs. Increase this only after
# increasing the OrbStack profile below and accounting for concurrent job load.
RUNNER_COUNT=1

# Runner names default to little-ci-owner-repo-fleet-id-<n> (or the organization
# equivalent), so multiple targets and fleets can coexist. An explicit prefix is
# an advanced compatibility override; otherwise FLEET_ID is required.
# RUNNER_NAME_PREFIX="little-ci-acme-widget-mac-studio"
RUNNER_LABELS="little-ci"

# GitHub Actions runner version to install.
# Releases: https://github.com/actions/runner/releases
RUNNER_VERSION="2.337.0"

# Generic Linux provisioning detects linux-x64 or linux-arm64 automatically.
# OrbStack provisioning is intentionally Apple Silicon/linux-arm64 only.
# RUNNER_ARCH="linux-arm64"

# Unix user for runner services. OrbStack installs services through orbctl as
# root, without leaving this account in sudo. Docker group access is itself
# root-equivalent and should only be granted to a trusted runner account.
RUNNER_USER="deploy"

# Anti-OOM swap: ONE swapfile per runner, this many GB each. On an 8 GB box
# running heavy jobs, this is what keeps a spike from OOM-killing a build.
# OrbStack ignores SWAP_GB and uses its managed zram/swap.
SWAP_GB=10
SWAPPINESS=10
# Opt in only to remove legacy /swapfileN files that an older Little-CI release
# recorded in /etc/fstab. The default preserves them and prints a warning.
REMOVE_LEGACY_SWAPFILES=0

# Reaper: age /tmp and each /scratch/RUNNER_NAME_PREFIX/N directory at this
# interval so dead job-workspace dirs cannot fill the disk.
REAP_AGE="6h"

# Health check target: how many runners should be ONLINE (defaults to RUNNER_COUNT).
EXPECTED_RUNNERS=1

# --- OrbStack on Apple Silicon (provision-orbstack.sh, install-runners-orb.sh) ---
# The machine is Ubuntu 24.04 arm64 with Mac mounts/integration disabled and
# host/peer-machine networking blocked. Defaults suit an 8–16 GB Mac.
# Defaults to the target-and-fleet-derived runner prefix, for example
# little-ci-acme-widget-mac-studio.
# ORB_MACHINE="little-ci-acme-widget-mac-studio"
ORB_CPUS=2
ORB_MEMORY="4G"
ORB_DISK="48G"

# Suggested larger profiles (change all values together):
# 16–24 GB Mac, one runner: ORB_CPUS=4, ORB_MEMORY="8G", ORB_DISK="64G"
# 32+ GB Mac, two runners: RUNNER_COUNT=2, EXPECTED_RUNNERS=2,
#                         ORB_CPUS=6, ORB_MEMORY="16G", ORB_DISK="96G"

# --- Optional: shared test Postgres (provision-postgres.sh) ---
# One small native Postgres all runners share; each CI run isolates itself in its own
# schema (see examples/ci-per-run-schema.yml). PG_PASSWORD is a LOCAL-only credential —
# keep Postgres bound to localhost and never expose 5432.
PG_USER="ci"
PG_PASSWORD="ci"
PG_DB="ci"
PG_SHARED_BUFFERS="128MB"
PG_MAX_CONNECTIONS=100
