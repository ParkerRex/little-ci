# Copy to config.env and edit. config.env is git-ignored (it can hold nothing
# secret, but keeping it out of git avoids accidental commits of your repo URL).
# All three scripts source config.env if it is present.

# Repo (or org) the runners register against.
GITHUB_URL="https://github.com/OWNER/REPO"

# How many runners to provision on this box.
RUNNER_COUNT=3

# Runner naming + labels. Each runner is named <prefix>-<n> and additionally
# gets its own <prefix>-<n> label (so a workflow can target one exact runner).
RUNNER_NAME_PREFIX="ci"
RUNNER_LABELS="self-hosted"

# GitHub Actions runner version to install.
# Releases: https://github.com/actions/runner/releases
RUNNER_VERSION="2.336.0"

# Unix user the runner services run as. Must have passwordless sudo (svc.sh needs
# it) and be in the `docker` group if your jobs build/run containers.
RUNNER_USER="deploy"

# Anti-OOM swap: ONE swapfile per runner, this many GB each. On an 8 GB box
# running heavy jobs, this is what keeps a spike from OOM-killing a build.
SWAP_GB=10
SWAPPINESS=10

# Reaper: age /tmp and each /scratch/N at this interval so dead job-workspace
# dirs can't silt up and tip a build into "No space left on device".
REAP_AGE="6h"

# Health check target: how many runners should be ONLINE (defaults to RUNNER_COUNT).
EXPECTED_RUNNERS=3
